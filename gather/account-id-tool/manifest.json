{
  "manifest_version": 3,
  "name": "Gather",
  "version": "1.8.8",
  "description": "Local research with exact account IDs, reviewed Case Start, roles, scan continuity, capture and evidence export.",
  "minimum_chrome_version": "116",
  "permissions": [
    "scripting",
    "storage",
    "clipboardWrite",
    "activeTab",
    "sidePanel",
    "contextMenus",
    "downloads"
  ],
  "host_permissions": [
    "https://*.instagram.com/*",
    "https://*.facebook.com/*",
    "https://*.tiktok.com/*",
    "https://*.youtube.com/*",
    "https://*.threads.com/*",
    "https://*.threads.net/*"
  ],
  "icons": {
    "16": "icons/16.png",
    "48": "icons/48.png",
    "128": "icons/128.png"
  },
  "action": {
    "default_title": "Gather \u2014 capture and account lookup",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/16.png",
      "48": "icons/48.png"
    }
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'none'; base-uri 'none'"
  },
  "version_name": "1.8.8 live lookup validation development",
  "side_panel": {
    "default_path": "workspace.html?panel=1"
  }
}
